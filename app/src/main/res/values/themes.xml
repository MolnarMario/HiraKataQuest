<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HiraganaTrace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FBF8F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FBF8F4</item>
        <!-- The app is deliberately light-only (warm paper design); without
             this opt-out, devices with system dark mode force-invert the
             whole UI (verified on Pixel 7 / Android 16). Ignored below
             API 29, where force-dark does not exist. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
