<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HiraganaTrace" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Bar colors are NOT set here: MainActivity calls enableEdgeToEdge(),
             which makes the bars transparent and draws the app's background
             behind them (content is inset via safeDrawing in PracticeScreen).
             MainActivity re-applies the bar styles per the in-app Appearance
             setting (System / Light / Dark), so icon polarity follows the
             app's theme, not the OS's. This value is only the pre-first-frame
             default, which matches the LIGHT default. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- The app controls dark mode itself (AppearanceMode, resolved in
             MainActivity → HiraganaTheme). Force-dark stays OFF: its blind
             inversion produced a broken mixed look (verified on Pixel 7 /
             Android 16), so we design every dark color ourselves. Ignored
             below API 29, where force-dark does not exist. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
