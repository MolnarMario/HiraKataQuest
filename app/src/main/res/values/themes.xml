<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HiraganaTrace" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Bar colors are NOT set here: MainActivity calls enableEdgeToEdge(),
             which makes the bars transparent and draws the app's washi
             background behind them (content is inset via safeDrawing in
             PracticeScreen). windowLightStatusBar keeps dark icons on the
             light background. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- The app is deliberately light-only (warm paper design); without
             this opt-out, devices with system dark mode force-invert the
             whole UI (verified on Pixel 7 / Android 16). Ignored below
             API 29, where force-dark does not exist. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
